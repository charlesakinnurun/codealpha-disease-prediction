# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Data (licensed / large; regenerate with `make data`) ---
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep
# Vendored UCI heart folder is small and useful for offline repro, keep it:
!data/heart+disease/**

# --- Model artifacts (large binaries; regenerate with `make train`) ---
artifacts/models/**
!artifacts/models/.gitkeep
artifacts/runs/**
!artifacts/runs/.gitkeep

# --- Generated reports (keep figures + metrics summaries, ignore heavy outputs) ---
reports/figures/**
!reports/figures/.gitkeep
reports/tmp/

# --- Streamlit / OS cruft ---
.streamlit/secrets.toml
*.log
.DS_Store
Thumbs.db
desktop.ini
