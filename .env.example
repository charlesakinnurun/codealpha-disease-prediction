# Copy to `.env` and adjust as needed. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# Paths (relative to repository root unless absolute)
DP_DATA_DIR=data
DP_ARTIFACTS_DIR=artifacts
DP_REPORTS_DIR=reports
DP_CONFIG_DIR=configs

# Reproducibility
DP_RANDOM_SEED=42
DP_LOG_LEVEL=INFO

# API service
DP_API_HOST=0.0.0.0
DP_API_PORT=8000
DP_API_MAX_BODY_BYTES=32768
# Comma-separated list of allowed CORS origins. Empty = CORS disabled.
DP_API_CORS_ORIGINS=

# Serving behaviour
DP_MODEL_CACHE_SIZE=8
# When true, missing optional (non-clinical) fields are imputed by the
# pipeline. When false, the API rejects requests missing required fields.
DP_ALLOW_OPTIONAL_IMPUTATION=true
